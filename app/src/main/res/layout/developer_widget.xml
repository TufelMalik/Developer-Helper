<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="#20242B">
    <Button android:id="@+id/developer_options" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Developer options" android:textAllCaps="false" />
    <Button android:id="@+id/wireless_debugging" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Wireless debugging" android:textAllCaps="false" />
    <Button android:id="@+id/usb_debugging" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="USB debugging" android:textAllCaps="false" />
</LinearLayout>
